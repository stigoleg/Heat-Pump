        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringen ble ikke sendt fordi svaret fra MELCloud manglet fullstendig status for varmepumpen."
          }
        }
      }
    },
    "The change was not sent because the app must first fetch a fresh status from the heat pump, and it was fetched recently. Try again after %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringen ble ikke sendt fordi appen først må hente fersk status fra varmepumpen, og det er hentet nylig. Prøv igjen etter %@."
          }
        }
      }
    },
    "The change was not sent because the status from the heat pump could not be fetched first: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringen ble ikke sendt fordi status fra varmepumpen ikke kunne hentes først: %@"
          }
        }
      }
    },
    "The change was rejected by the user." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringen ble avvist av brukeren."
          }
        }
      }
    },
    "The compressor has started %lld times in the last 3 hours, with %lld or more starts in %lld of the hours. Such short runs wear on the compressor and lower the efficiency." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren har startet %lld ganger de siste 3 timene, med %lld eller flere starter i %lld av timene. Så korte runder sliter på kompressoren og gir dårligere virkningsgrad."
          }
        }
      }
    },
    "The compressor has started on average %.1f times an hour in the last 3 hours while heating. More than 3–4 starts an hour over time counts as short cycling." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren har startet i snitt %.1f ganger i timen de siste 3 timene mens den varmet. Mer enn 3–4 starter i timen over tid regnes som korte runder."
          }
        }
      }
    },
    "The compressor has stopped for overcurrent or a start-up failure three times in a row." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren har stoppet for overstrøm eller oppstartsfeil tre ganger på rad."
          }
        }
      }
    },
    "The compressor is idle. This happens when the room is warm enough, and otherwise for a short while between two runs. It starts again by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren står. Det skjer når rommet er varmt nok, og ellers en kort stund mellom to runder. Den starter igjen av seg selv."
          }
        }
      }
    },
    "The compressor is running and cooling the room." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren går og kjøler rommet."
          }
        }
      }
    },
    "The compressor is running and heating the room." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren går og varmer rommet."
          }
        }
      }
    },
    "The compressor is running in automatic mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren går i automatisk modus."
          }
        }
      }
    },
    "The compressor starts and stops often" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren starter og stopper ofte"
          }
        }
      }
    },
    "The compressor starts and stops very often" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompressoren starter og stopper svært ofte"
          }
        }
      }
    },
    "The contact email does not look right." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt-e-posten ser ikke riktig ut."
          }
        }
      }
    },
    "The control board cannot read its memory." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrekortet klarer ikke å lese minnet sitt."
          }
        }
      }
    },
    "The data is old" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene er gamle"
          }
        }
      }
    },
    "The date cannot be in the future." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoen kan ikke være frem i tid."
          }
        }
      }
    },
    "The download is being retried." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastingen prøves på nytt."
          }
        }
      }
    },
    "The end of holiday mode cannot be in the past." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutten på feriemodus kan ikke være passert."
          }
        }
      }
    },
    "The end of holiday mode must be after the start." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutten på feriemodus må være etter starten."
          }
        }
      }
    },
    "The estimate is based on how the price has varied through the day over the last four weeks and the level over the last week, adjusted for the weather forecast when the price has followed the temperature; actual prices for tomorrow arrive around 13:00." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslaget bygger på hvordan prisen har variert gjennom døgnet de siste fire ukene og nivået den siste uka, justert for værvarselet når prisen har fulgt temperaturen; virkelige priser for i morgen kommer rundt kl. 13."
          }
        }
      }
    },
    "The estimate needs at least %lld days of stored prices." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslaget trenger minst %lld dager med lagrede priser."
          }
        }
      }
    },
    "The event on %@ at %@ is missing on/off, mode or temperature." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hendelsen %@ kl. %@ mangler av/på, modus eller temperatur."
          }
        }
      }
    },
    "The fan motor gives no speed signal." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viftemotoren gir ikke turtallssignal."
          }
        }
      }
    },
    "The firmware update has started. Follow it under Health → Firmware. It can take a while, and the Wi-Fi adapter restarts along the way." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fastvareoppdateringen er startet. Følg med under Helse → Fastvare. Den kan ta en stund, og Wi-Fi-modulen starter på nytt underveis."
          }
        }
      }
    },
    "The green V-blocking filter should be cleaned" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det grønne V-blokkerende filteret bør rengjøres"
          }
        }
      }
    },
    "The heat pump appears to be working normally" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen ser ut til å fungere normalt"
          }
        }
      }
    },
    "The heat pump has defrosted more than %lld times an hour for %lld hours in a row in the last day. Normally it defrosts every 40–90 minutes of running in damp cold. The limit is a rule of thumb." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen har avrist mer enn %lld ganger i timen i %lld timer på rad siste døgn. Normalt avriser den hvert 40.–90. driftsminutt i fuktig kulde. Grensen er en tommelfingerregel."
          }
        }
      }
    },
    "The heat pump has just started and is getting going." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen har nettopp startet og kommer i gang."
          }
        }
      }
    },
    "The heat pump has no contact with MELCloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen har ikke kontakt med MELCloud"
          }
        }
      }
    },
    "The heat pump has not reported a target temperature." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen har ikke meldt ønsket temperatur."
          }
        }
      }
    },
    "The heat pump has set an error flag, but MELCloud gives no error code. So we do not know what the error is about." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen har satt et feilflagg, men MELCloud oppgir ingen feilkode. Vi vet derfor ikke hva feilen gjelder."
          }
        }
      }
    },
    "The heat pump is off (frost protection is watching)." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen er av (frostsikringen passer på)."
          }
        }
      }
    },
    "The heat pump is off." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen er av."
          }
        }
      }
    },
    "The heat pump is reporting an error" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen melder feil"
          }
        }
      }
    },
    "The heat pump is reporting an error now" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen melder feil nå"
          }
        }
      }
    },
    "The heat pump is reporting an error now (local)" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen melder feil nå (lokal)"
          }
        }
      }
    },
    "The heat pump is taking moisture out of the air." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen tar fukt ut av lufta."
          }
        }
      }
    },
    "The heat pump is turned off." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen er slått av."
          }
        }
      }
    },
    "The heat pump must have power and good Wi-Fi the whole time. Do not disconnect it from power and do not use the remote control (the local controller) while the update runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen må stå på strøm og ha godt Wi-Fi hele tiden. Ikke koble den fra strømmen og ikke bruk fjernkontrollen (den lokale styringen) mens oppdateringen pågår."
          }
        }
      }
    },
    "The heat pump reports no valid mode. Choose a mode (for example Heat) together with the change." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen rapporterer ingen gyldig modus. Velg modus (for eksempel Varme) samtidig med endringen."
          }
        }
      }
    },
    "The heat pump uses more electricity than usual for the temperature" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmepumpen bruker mer strøm enn vanlig for temperaturen"
          }
        }
      }
    },
    "The highest frost protection temperature must be 6–16 °C." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyeste temperatur for frostsikring må være 6–16 °C."
          }
        }
      }
    },
    "The highest temperature must be at least 2 °C above the lowest (for example 8 and 10 °C)." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyeste temperatur må være minst 2 °C over laveste (for eksempel 8 og 10 °C)."
          }
        }
      }
    },
    "The indoor unit receives no signal from the outdoor unit." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innedelen mottar ikke signal fra utedelen."
          }
        }
      }
    },
    "The indoor unit warms up before the fan starts in earnest, so it does not blow cold air." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innedelen varmes opp før viften starter for fullt, så den ikke blåser kald luft."
          }
        }
      }
    },
    "The last update of the Wi-Fi adapter did not complete." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siste oppdatering av Wi-Fi-modulen ble ikke fullført."
          }
        }
      }
    },
    "The latest status is from %@. %@ The assessments below apply to that time." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siste status er fra %@. %@ Vurderingene under gjelder det tidspunktet."
          }
        }
      }
    },
    "The lowest frost protection temperature must be 4–14 °C." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laveste temperatur for frostsikring må være 4–14 °C."
          }
        }
      }
    },
    "The lowest temperature must be 16–22 °C." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laveste temperatur må være 16–22 °C."
          }
        }
      }
    },
    "The number of hours lowered per day must be 1–24." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall timer som senkes per døgn må være 1–24."
          }
        }
      }
    },
    "The outdoor unit control board cannot read its memory." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrekortet i utedelen klarer ikke å lese minnet sitt."
          }
        }
      }
    },
    "The outdoor unit defrosts unusually often" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utedelen avriser uvanlig ofte"
          }
        }
      }
    },
    "The outdoor unit is melting away ice that has built up. Meanwhile little or cold air comes from the indoor unit. This is perfectly normal in cold, damp weather and usually takes 3–10 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utedelen smelter bort is som har samlet seg. Imens kommer det lite eller kald luft fra innedelen. Det er helt normalt i kaldt og fuktig vær og tar vanligvis 3–10 minutter."
          }
        }
      }
    },
    "The outdoor unit may have ice or poor airflow — check that it is free of snow, ice and leaves, and that nothing stands close to it. Do not chip ice off with tools; let it melt or use lukewarm water. If it continues after the outdoor unit has been cleared, call the dealer." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utedelen kan ha is eller dårlig luftstrøm — sjekk at den er fri for snø/is og løv, og at ingenting står tett inntil den. Ikke hakk løs is med verktøy; la den smelte eller bruk lunkent vann. Fortsetter det etter at utedelen er ryddet, ring forhandleren."
          }
        }
      }
    },
    "The outdoor unit spends a lot of time defrosting" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utedelen bruker mye tid på avriming"
          }
        }
      }
    },
    "The pipe sensor or room temperature sensor is short-circuited or open." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rørføler eller romtemperaturføler er kortsluttet eller brutt."
          }
        }
      }
    },
    "The reduction must be 0–4 °C." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkingen må være 0–4 °C."
          }
        }
      }
    },
    "The room is not reaching the target temperature" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rommet når ikke ønsket temperatur"
          }
        }
      }
    },
    "The search was just run. Wait a minute before you try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søket ble nettopp kjørt. Vent et minutt før du prøver igjen."
          }
        }
      }
    },
    "The seasons are not valid. Check the start dates." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesongene er ikke gyldige. Sjekk startdatoene."
          }
        }
      }
    },
    "The signal strength is %lld dBm, which is weak. It can cause dropouts in the connection to MELCloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalstyrken er %lld dBm, som er svakt. Det kan gi brudd i kontakten med MELCloud."
          }
        }
      }
    },
    "The signal strength is %lld dBm. It usually works, but it is not strong." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalstyrken er %lld dBm. Det fungerer som regel, men er ikke sterkt."
          }
        }
      }
    },
    "The status from the heat pump lacks %@, so the change was not sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status fra varmepumpen mangler %@, så endringen ble ikke sendt."
          }
        }
      }
    },
    "The temperature on %@ at %@ must be %@–%@ in steps of 0.5 °C (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperaturen %@ kl. %@ må være %@–%@ i trinn på 0,5 °C (%@)."
          }
        }
      }
    },
    "The text comes directly from MELCloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten kommer direkte fra MELCloud."
          }
        }
      }
    },
    "The text comes directly from MELCloud. Possible interpretation: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten kommer direkte fra MELCloud. Mulig tolkning: %@"
          }
        }
      }
    },
    "The token works. Found %lld hourly prices for today." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkkelen virker. Fant %lld timepriser for i dag."
          }
        }
      }
    },
    "The unit is disconnected from MELCloud. The update can be started when it is connected again." : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheten er frakoblet fra MELCloud. Oppdateringen kan startes når den er tilkoblet igjen."
          }
        }
      }
    },
    "The unit is downloading new firmware." : {
      "extractionState" : "manual",
