    "Status fetched %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status hentet %@"
          }
        }
      }
    },
    "Status is fetched at most once a minute and otherwise from the cache (10 minutes). History is fetched at most once an hour." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status hentes høyst én gang i minuttet og ellers fra lageret (10 minutter). Historikk hentes høyst én gang i timen."
          }
        }
      }
    },
    "Stopped" : {
