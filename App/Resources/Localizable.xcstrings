    "Rough estimate: consumption against how cold it has been over the last %lld days, tomorrow’s forecast and electricity prices." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
